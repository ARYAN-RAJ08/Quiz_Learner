# Server Configuration
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/quiz_learner
# Or for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/quiz_learner?retryWrites=true&w=majority

# JWT Secret Key (use a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-to-something-random

# Admin Registration Code (optional, has default)
ADMIN_CODE=SECRET_ADMIN_CODE

# Email Configuration (for password reset functionality)
EMAIL_SERVICE=gmail
# Options: 'gmail', 'outlook', 'yahoo', etc.
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password-or-email-password
# Note: For Gmail, you need to use an App Password, not your regular password
# Generate one at: https://myaccount.google.com/apppasswords

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:3000